<Window x:Class="MasrLab.Presentation.Views.SystemSettings.ReferenceValuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MasrLab - تعديل القيم المرجعية للتحاليل" Width="1100" Height="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Language="ar-EG"
        Background="#F0F0F0">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: شريط معلومات التحليل -->
        <Border Grid.Row="0" Background="#E8E8E8" Padding="8" Margin="0,0,0,5" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Test Name:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                <Border Grid.Column="1" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="2" MinWidth="150" Margin="0,0,20,0">
                    <TextBlock Text="{Binding TestName}" VerticalAlignment="Center" Padding="5,3"/>
                </Border>

                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Bold" Foreground="Red">
                    <Run Text="Number Of References = "/>
                    <Run Text="{Binding ReferenceValues.Count, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" Reference"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Row 0.5: مكون التحليل -->
        <Border Grid.Row="1" Background="#FFF9C4" Padding="8" Margin="0,0,0,5" CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Test Component:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <ComboBox Width="250" SelectedItem="{Binding SelectedComponent}"
                          ItemsSource="{Binding Components}"
                          DisplayMemberPath="Name"/>
            </StackPanel>
        </Border>

        <!-- Row 2: DataGrid القيم المرجعية -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ReferenceValues}"
                  SelectedItem="{Binding SelectedReferenceValue}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F5F5"
                  Background="White"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  Margin="0,0,0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="80"/>
                <DataGridTextColumn Header="From" Binding="{Binding AgeMin}" Width="60"/>
                <DataGridTextColumn Header="To" Binding="{Binding AgeMax}" Width="60"/>
                <DataGridTextColumn Header="Age unit" Binding="{Binding AgeUnit}" Width="80"/>
                <DataGridTextColumn Header="Reference range" Binding="{Binding NormalRange}" Width="150"/>
                <DataGridTextColumn Header="Low limit" Binding="{Binding LowLimit, StringFormat=F2}" Width="80"/>
                <DataGridTextColumn Header="High limit" Binding="{Binding HighLimit, StringFormat=F2}" Width="80"/>
                <DataGridTextColumn Header="Test unit" Binding="{Binding TestUnit}" Width="80"/>
                <DataGridTextColumn Header="Low flag" Binding="{Binding LowFlag}" Width="80"/>
                <DataGridTextColumn Header="High flag" Binding="{Binding HighFlag}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3: قسم Reference Setting + حقول التعليقات -->
        <Border Grid.Row="3" Background="#E8E8E8" Padding="10" CornerRadius="3" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- العمود الأيسر: Reference Setting -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Reference Setting" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#333"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Range for -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Range for" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                <RadioButton Content="For all" Margin="0,0,10,0"
                                             IsChecked="{Binding SelectedRangeForMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ForAll}"/>
                                <RadioButton Content="By sex and age" Margin="0,0,10,0"
                                             IsChecked="{Binding SelectedRangeForMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BySexAndAge}"/>
                                <RadioButton Content="By sex only" Margin="0,0,10,0"
                                             IsChecked="{Binding SelectedRangeForMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BySexOnly}"/>
                                <RadioButton Content="By age only"
                                             IsChecked="{Binding SelectedRangeForMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ByAgeOnly}"/>
                            </StackPanel>

                            <!-- Gender -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gender" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                <RadioButton Content="Male" Margin="0,0,10,0"
                                             IsEnabled="{Binding IsGenderEnabled}"
                                             IsChecked="{Binding SelectedGender, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Male}"/>
                                <RadioButton Content="Female"
                                             IsEnabled="{Binding IsGenderEnabled}"
                                             IsChecked="{Binding SelectedGender, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Female}"/>
                            </StackPanel>

                            <!-- Age from / to -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Age from" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,10,0"
                                     IsEnabled="{Binding IsAgeEnabled}"
                                     Text="{Binding AgeFrom, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="to" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="3"
                                     IsEnabled="{Binding IsAgeEnabled}"
                                     Text="{Binding AgeTo, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Age unit -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Age unit" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                                      IsEnabled="{Binding IsAgeEnabled}"
                                      SelectedItem="{Binding SelectedAgeUnit}"
                                      ItemsSource="{Binding AgeUnits}"/>

                            <!-- Reference range -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Reference range" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"
                                     Text="{Binding ReferenceRange, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="40"
                                     VerticalScrollBarVisibility="Auto"/>

                            <!-- Low limit / High limit -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Low limit" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Margin="0,0,10,0"
                                     IsEnabled="{Binding IsNumericLimitsEnabled}"
                                     Text="{Binding LowLimit, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" Text="High limit" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="10" Grid.Column="3"
                                     IsEnabled="{Binding IsNumericLimitsEnabled}"
                                     Text="{Binding HighLimit, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Low flag / High flag -->
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Low flag" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="12" Grid.Column="1" Margin="0,0,10,0"
                                     IsEnabled="{Binding IsNumericLimitsEnabled}"
                                     Text="{Binding LowFlag, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="12" Grid.Column="2" Text="High flag" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="12" Grid.Column="3"
                                     IsEnabled="{Binding IsNumericLimitsEnabled}"
                                     Text="{Binding HighFlag, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Test unit -->
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Test unit" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="3"
                                     Text="{Binding TestUnit, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- For pregnant only -->
                            <CheckBox Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="4"
                                      Content="for pregnant only"
                                      IsChecked="{Binding ForPregnantOnly}" Margin="0,5,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- العمود الأيمن: حقول التعليقات -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <StackPanel>
                        <TextBlock Text="Comments" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#333"/>

                        <!-- Low comment -->
                        <Border Background="White" Padding="8" Margin="0,0,0,8" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Low comment" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#333"/>
                                <TextBox Text="{Binding LowComment, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="100"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- High comment -->
                        <Border Background="White" Padding="8" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="High comment" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#333"/>
                                <TextBox Text="{Binding HighComment, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="100"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Row 4: شريط الأزرار السفلية (من اليمين لليسار) -->
        <Border Grid.Row="4" Background="#E8E8E8" Padding="8" CornerRadius="3">
            <WrapPanel HorizontalAlignment="Center">
                <!-- إضافة مدى -->
                <Button Content="إضافة مدى" Command="{Binding AddNewCommand}"
                        Padding="20,8" Margin="5" Background="#00BCD4" Foreground="White" FontWeight="Bold"/>
                <!-- تعديل -->
                <Button Content="تعديل" Command="{Binding UpdateCommand}"
                        Padding="20,8" Margin="5" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                <!-- حفظ -->
                <Button Content="حفظ" Command="{Binding SaveCommand}"
                        Padding="20,8" Margin="5" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                <!-- تراجع -->
                <Button Content="تراجع" Command="{Binding DiscardChangesCommand}"
                        Padding="20,8" Margin="5" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                <!-- حذف -->
                <Button Content="حذف" Command="{Binding DeleteCommand}"
                        Padding="20,8" Margin="5" Background="#f44336" Foreground="White" FontWeight="Bold"/>
                <!-- قائمة التحاليل -->
                <Button Content="قائمة التحاليل" Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="20,8" Margin="5" Background="#607D8B" Foreground="White" FontWeight="Bold"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
