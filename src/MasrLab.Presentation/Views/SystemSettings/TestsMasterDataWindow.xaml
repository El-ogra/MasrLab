<Window x:Class="MasrLab.Presentation.Views.SystemSettings.TestsMasterDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasrLab.Presentation.ViewModels.SystemSettings"
        Title="MasrLab - بيانات التحاليل" Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Language="ar-EG"
        Loaded="Window_Loaded"
        Background="#F0F0F0">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط البحث العلوي -->
        <Border Grid.Row="0" Background="#E8E8E8" Padding="8" Margin="0,0,0,5" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Search by test name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" x:Name="SearchByNameBox" VerticalAlignment="Center" Margin="0,0,15,0"
                         Text="{Binding SearchByName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="2" Text="By group name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="3" x:Name="SearchByGroupBox" VerticalAlignment="Center" Margin="0,0,15,0"
                         Text="{Binding SearchByGroup, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="4" Text="By test ID:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="5" x:Name="SearchByIdBox" VerticalAlignment="Center" Margin="0,0,15,0"
                         Text="{Binding SearchById, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="6" Content="بحث" Command="{Binding SearchCommand}"
                        Padding="15,5" Margin="0,0,15,0" Background="#4CAF50" Foreground="White"/>

                <TextBlock Grid.Column="8" VerticalAlignment="Center" FontWeight="Bold" Foreground="Red">
                    <Run Text="Number Of Tests = "/>
                    <Run Text="{Binding TotalTestsCount, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" Tests"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- جدول التحاليل -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Tests}"
                  SelectedItem="{Binding SelectedTest}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F5F5"
                  Background="White"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  Margin="0,0,0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Arrang" Binding="{Binding ArrangeNo}" Width="60"/>
                <DataGridTextColumn Header="Group Name" Binding="{Binding Group}" Width="150"/>
                <DataGridTextColumn Header="Test Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Pat. P" Binding="{Binding Price, StringFormat=F2}" Width="70"/>
                <DataGridTextColumn Header="Lab P" Binding="{Binding LabToLabPrice, StringFormat=F2}" Width="70"/>
                <DataGridTextColumn Header="Out Lab Name" Binding="{Binding OutsourcedLabName}" Width="120"/>
                <DataGridTextColumn Header="Out P" Binding="{Binding OutsourcedCostPrice, StringFormat=F2}" Width="70"/>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- قسم التفاصيل السفلي -->
        <Border Grid.Row="2" Background="#E8E8E8" Padding="10" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- العمود الأيسر: معلومات التحليل -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Test Information" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#333"/>

                        <!-- صفوف الحقول -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Test Name -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Test Name" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Test Code" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TestCode, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Report Name -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Report Name" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReportName, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3" Margin="0,0,0,0"/>

                            <!-- Eill Name -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Eill Name" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EillName, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3"/>

                            <!-- History Name -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="History Name" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding HistoryName, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3"/>

                            <!-- Arabic Name -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Arabic Name" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ArabicName, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3"/>

                            <!-- Group Name -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Group Name" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                                      Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      ItemsSource="{Binding GroupNames}"/>

                            <!-- Branch -->
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Branch" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="12" Grid.Column="2" Text="Log Group" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="12" Grid.Column="3" Text="{Binding LogGroup, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Collection -->
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Collection" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3"/>

                            <!-- خانات الاختيار -->
                            <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,5,0,0">
                                <CheckBox Content="See Report" IsChecked="{Binding SeeReport}" Margin="0,0,15,0"/>
                                <CheckBox Content="Print with other" IsChecked="{Binding PrintWithOther}" Margin="0,0,15,0"/>
                                <CheckBox Content="Add with group" IsChecked="{Binding AddToGroup}" Margin="0,0,15,0"/>
                                <CheckBox Content="Main test" IsChecked="{Binding IsMainTest}"/>
                            </StackPanel>

                            <!-- Test time و Arrange No -->
                            <TextBlock Grid.Row="18" Grid.Column="0" Text="Test time (Day)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="18" Grid.Column="1" Text="{Binding TestTimeDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="18" Grid.Column="2" Text="Arrange No." VerticalAlignment="Center"/>
                            <TextBox Grid.Row="18" Grid.Column="3" Text="{Binding ArrangeNo, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Reference type و الأسعار -->
                            <TextBlock Grid.Row="20" Grid.Column="0" Text="Reference type" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="20" Grid.Column="1" Margin="0,0,10,0"
                                      SelectedItem="{Binding ReferenceType}"
                                      ItemsSource="{Binding ReferenceTypes}"/>
                            <TextBlock Grid.Row="20" Grid.Column="2" Text="Patient price" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="20" Grid.Column="3" Text="{Binding PatientPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- العمود الأيمن: Barcode + Sent outside Lab + Patient Question -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <StackPanel>
                        <!-- قسم Barcode -->
                        <Border Background="White" Padding="8" Margin="0,0,0,8" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Barcode" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#333"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BarcodeName, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tube 1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Tube1, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Tube 2" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Tube2, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tube 3" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Tube3, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- قسم Sent outside Lab -->
                        <Border Background="White" Padding="8" Margin="0,0,0,8" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Sent outside Lab." FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#333"/>
                                <CheckBox Content="تفعيل الإرسال لمعمل خارجي" IsChecked="{Binding SentOutsideLab}" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Lab Name" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              IsEnabled="{Binding SentOutsideLab}"
                                              Text="{Binding OutsourcedLabName, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              ItemsSource="{Binding ExternalLabNames}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cost price" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             IsEnabled="{Binding SentOutsideLab}"
                                             Text="{Binding OutsourcedCostPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- قسم Patient Question -->
                        <Border Background="White" Padding="8" CornerRadius="3" BorderBrush="#CCC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Patient Question" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#333"/>
                                <TextBox Text="{Binding PatientQuestion, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- حقل Lab to lab price -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lab to lab price" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding LabToLabPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- شريط الأزرار السفلية -->
        <Border Grid.Row="3" Background="#E8E8E8" Padding="8" Margin="0,5,0,0" CornerRadius="3">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="القائمة الرئيسية" Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="20,8" Margin="5" Background="#607D8B" Foreground="White" FontWeight="Bold"/>
                <Button Content="القيم المرجعية" Command="{Binding OpenReferenceValuesCommand}"
                        Padding="20,8" Margin="5" Background="#9C27B0" Foreground="White" FontWeight="Bold"/>
                <Button Content="حذف" Command="{Binding DeleteTestCommand}"
                        Padding="20,8" Margin="5" Background="#f44336" Foreground="White" FontWeight="Bold"/>
                <Button Content="ترحيل" Command="{Binding TransferCommand}"
                        Padding="20,8" Margin="5" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                <Button Content="حفظ" Command="{Binding SaveTestCommand}"
                        Padding="20,8" Margin="5" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                <Button Content="تعديل" Command="{Binding UpdateTestCommand}"
                        Padding="20,8" Margin="5" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                <Button Content="اضافة تحليل" Command="{Binding AddNewTestCommand}"
                        Padding="20,8" Margin="5" Background="#00BCD4" Foreground="White" FontWeight="Bold"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
